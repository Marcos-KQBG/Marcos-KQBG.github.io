---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import FondoAnimado from '../components/FondoAnimado.astro';
import Hero from '../components/Hero.astro';
import Servicios from '../components/Servicios.astro';
import Historia from '../components/Historia.astro';
import Galeria from '../components/Galeria.astro';
import Ubicacion from '../components/Ubicacion.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import BotonWhatsapp from '../components/BotonWhatsapp.astro';
---

<Base>
  <FondoAnimado />
  <Header />
  <main id="contenido">
    <Hero />
    <Servicios />
    <Historia />
    <Galeria />
    <Ubicacion />
    <Contacto />
  </main>
  <Footer />
  <BotonWhatsapp />
</Base>
