---
import { clinica } from '../data/clinica.js';
const d = clinica.direccion;
const mapaQuery = encodeURIComponent(
  `${d.calle} ${d.cp} ${d.localidad} ${d.provincia}`
);
---

<section id="ubicacion">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow"><span class="dot"></span>Dónde estamos</span>
      <h2>En el centro de Magallón</h2>
    </div>

    <div class="loc-grid">
      <div class="loc-info reveal">
        <div class="loc-line">
          <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0118 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <div>
            <div class="k">DIRECCIÓN</div>
            <div class="v">{d.calle}<br />{d.cp} {d.localidad}, {d.provincia}</div>
          </div>
        </div>

        <div class="loc-line">
          <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3 19.5 19.5 0 01-6-6 19.8 19.8 0 01-3-8.6A2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.4 1.8.7 2.7a2 2 0 01-.5 2.1L8.1 9.9a16 16 0 006 6l1.4-1.2a2 2 0 012.1-.4c.9.3 1.8.6 2.7.7a2 2 0 011.7 2z"></path>
          </svg>
          <div>
            <div class="k">TELÉFONO</div>
            <div class="v pending">{clinica.telefono}</div>
          </div>
        </div>

        <div class="loc-line">
          <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="M3 7l9 6 9-6"></path>
          </svg>
          <div>
            <div class="k">EMAIL</div>
            <div class="v"><a href={`mailto:${clinica.email}`}>{clinica.email}</a></div>
          </div>
        </div>

        <div class="loc-line">
          <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v5l3 3"></path>
          </svg>
          <div>
            <div class="k">HORARIO</div>
            <div class="v pending">{clinica.horario}</div>
          </div>
        </div>
      </div>

      <div class="map reveal">
        <iframe
          title="Mapa de El Perro Verde en Magallón"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src={`https://www.google.com/maps?q=${mapaQuery}&output=embed`}
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .loc-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 40px;
    align-items: stretch;
  }
  .loc-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .loc-line {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .loc-line:last-of-type {
    border-bottom: none;
  }
  .loc-line svg {
    width: 22px;
    height: 22px;
    stroke: var(--brand-deep);
    fill: none;
    stroke-width: 1.7;
    flex: none;
    margin-top: 3px;
  }
  .loc-line .k {
    font-weight: 600;
    font-size: 0.82rem;
    color: var(--brand-deep);
    letter-spacing: 0.02em;
  }
  .loc-line .v {
    color: var(--muted);
    font-size: 1.02rem;
  }
  .loc-line .v a:hover {
    color: var(--brand-deep);
  }
  .pending {
    font-style: italic;
    opacity: 0.7;
  }
  .map {
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    min-height: 360px;
  }
  .map iframe {
    width: 100%;
    height: 100%;
    min-height: 360px;
    border: 0;
    display: block;
  }

  @media (max-width: 900px) {
    .loc-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
