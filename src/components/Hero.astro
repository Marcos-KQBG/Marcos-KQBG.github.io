---
import { Image } from 'astro:assets';
import { enlaceWhatsapp } from '../data/clinica.js';
import heroPortada from '../assets/hero-portada.jpg';
const wa = enlaceWhatsapp();
---

<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-text">
      <span class="eyebrow reveal"
        ><span class="dot"></span>Nueva clínica en Magallón (Zaragoza)</span
      >
      <h1 class="reveal">
        El cuidado que tu mascota <span class="ital">merece</span>, cerca de
        casa.
      </h1>
      <p class="lead reveal">
        De la peluquería y tienda de Borja a una clínica veterinaria completa. La
        misma gente de siempre, ahora cuidando también su salud.
      </p>
      <div class="hero-cta reveal">
        <a class="btn wa-cta" href={wa} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 004.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2zm5.8 14.14c-.24.68-1.42 1.31-1.95 1.36-.5.05-1.13.07-1.83-.11-.42-.13-.96-.31-1.66-.61-2.92-1.26-4.82-4.2-4.97-4.4-.15-.2-1.2-1.59-1.2-3.03s.76-2.15 1.03-2.45c.27-.29.58-.36.78-.36.19 0 .39 0 .56.01.18.01.42-.07.66.5.24.59.82 2.03.89 2.18.07.15.12.32.02.51-.09.2-.14.32-.28.49-.14.17-.29.38-.42.51-.14.14-.28.29-.12.56.16.27.72 1.18 1.54 1.91 1.06.94 1.95 1.24 2.22 1.38.27.14.43.12.59-.07.16-.19.68-.79.86-1.06.18-.27.36-.22.61-.13.25.09 1.59.75 1.86.89.27.14.45.2.51.31.07.12.07.68-.17 1.35z"
            ></path>
          </svg>
          Pedir cita por WhatsApp
        </a>
        <a class="ghost" href="#servicios"
          >Ver servicios
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
          >
        </a>
      </div>
    </div>

    <div class="hero-panel reveal">
      <Image
        class="scene"
        src={heroPortada}
        alt="Perro y gato juntos, el cuidado cercano de El Perro Verde"
        width={700}
        height={467}
        loading="eager"
        decoding="async"
      />

      <div class="float-card fc1">
        <span class="num" data-count="5">5</span>
        <span class="lbl">años de experiencia</span>
      </div>
      <div class="float-card fc2">
        <svg
          viewBox="0 0 24 24"
          width="22"
          height="22"
          fill="none"
          stroke="#067a70"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path
            d="M12 21s-7-4.35-9.5-8.5C.5 8.5 3 5 6.5 5 9 5 12 8 12 8s3-3 5.5-3C21 5 23.5 8.5 21.5 12.5 19 16.65 12 21 12 21z"
          ></path></svg
        >
        <span class="lbl">Trato cercano y de confianza</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 72px 0 32px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
  }
  .eyebrow {
    margin-bottom: 22px;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 6vw, 4.1rem);
    margin-bottom: 22px;
  }
  .hero h1 .ital {
    font-style: italic;
    color: var(--brand-deep);
  }
  .hero p.lead {
    font-size: 1.16rem;
    color: var(--muted);
    max-width: 34ch;
    margin-bottom: 34px;
  }
  .hero-cta {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .ghost {
    font-weight: 600;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .ghost svg {
    width: 16px;
    height: 16px;
    transition: transform 0.2s;
  }
  .ghost:hover svg {
    transform: translateX(4px);
  }

  .hero-panel {
    position: relative;
    background: #fff;
    border-radius: 32px;
    padding: 40px;
    box-shadow: var(--shadow);
    border: 1px solid var(--line);
  }
  .hero-panel .scene {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 20px;
  }
  .float-card {
    position: absolute;
    background: #fff;
    border-radius: 16px;
    padding: 14px 18px;
    box-shadow: 0 18px 40px -22px rgba(6, 63, 58, 0.5);
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .float-card .num {
    font-family: var(--serif);
    font-size: 1.5rem;
    color: var(--brand-deep);
    line-height: 1;
  }
  .float-card .lbl {
    font-size: 0.78rem;
    color: var(--muted);
    max-width: 12ch;
  }
  .fc1 {
    bottom: -22px;
    left: -18px;
    animation: bob 6s ease-in-out infinite;
  }
  .fc2 {
    top: -20px;
    right: -14px;
    animation: bob 7s ease-in-out infinite 0.5s;
  }
  @keyframes bob {
    50% {
      transform: translateY(-9px);
    }
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hero-panel {
      order: -1;
      max-width: 440px;
      margin: 0 auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fc1,
    .fc2 {
      animation: none !important;
    }
  }
</style>
