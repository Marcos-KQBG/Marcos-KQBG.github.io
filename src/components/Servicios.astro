---
import ServicioCard from './ServicioCard.astro';
---

<section id="servicios">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow"><span class="dot"></span>Qué hacemos</span>
      <h2>Todo lo que tu mascota necesita, bajo un mismo techo</h2>
      <p>
        Medicina, cirugía y también el cuidado del día a día que ya conoces de
        nosotros.
      </p>
    </div>

    <div class="services">
      <ServicioCard
        titulo="Consulta general"
        texto="Revisiones, diagnóstico y seguimiento con tiempo para escucharte."
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 3v6a5 5 0 0010 0V3M6 3H4m2 0h1m9 0h2m-2 0h-1M11 14v3a4 4 0 004 4 4 4 0 004-4v-1"></path>
          <circle cx="19" cy="15" r="2"></circle>
        </svg>
      </ServicioCard>

      <ServicioCard
        titulo="Vacunación"
        texto="Calendarios de vacunas y desparasitación adaptados a cada mascota."
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M18 2l4 4M17 3l4 4-9 9-4 1 1-4z"></path>
          <path d="M8 13l-5 5m0 0l2 2m-2-2l2-2"></path>
        </svg>
      </ServicioCard>

      <ServicioCard
        titulo="Cirugía"
        texto="Intervenciones programadas en quirófano equipado, con seguridad."
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 4h8l-1 6H9zM9 10h6l1 8a3 3 0 01-3 3h-2a3 3 0 01-3-3z"></path>
        </svg>
      </ServicioCard>

      <ServicioCard
        titulo="Diagnóstico"
        texto="Analíticas y pruebas para llegar antes al origen del problema."
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 2h6M10 2v6l-5 9a3 3 0 003 5h8a3 3 0 003-5l-5-9V2"></path>
          <path d="M7 15h10"></path>
        </svg>
      </ServicioCard>

      <ServicioCard
        titulo="Peluquería canina"
        texto="El servicio de siempre: baño, corte y mimos para que salga radiante."
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="6" cy="6" r="3"></circle>
          <circle cx="6" cy="18" r="3"></circle>
          <path d="M8.5 8.5L20 20M8.5 15.5L20 4"></path>
        </svg>
      </ServicioCard>

      <ServicioCard
        titulo="Tienda de animales"
        texto="Alimentación y accesorios seleccionados, con consejo de verdad."
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 7h12l-1 13H7zM9 7V5a3 3 0 016 0v2"></path>
        </svg>
      </ServicioCard>
    </div>
  </div>
</section>

<style>
  .services {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  @media (max-width: 900px) {
    .services {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 680px) {
    .services {
      grid-template-columns: 1fr;
    }
  }
</style>
